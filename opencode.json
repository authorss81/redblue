{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 45000
      }
    },
    "rbops": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}",
        "baseURL": "https://opencode.ai/zen/v1",
        "headerTimeout": 60000,
        "chunkTimeout": 45000
      }
    }
  },
  "agent": {
    "reviewer": {
      "description": "Read-only reviewer for a redblue pipeline phase. Reviews the phase diff and emits findings; may not edit files, run commands, fetch the web, launch subagents, or touch paths outside the checkout.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "deny",
        "skill": "deny",
        "lsp": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "doom_loop": "deny",
        "external_directory": "deny"
      }
    },
    "verifier": {
      "description": "Runs a redblue pipeline phase's gates. Needs the toolchain, so it is not read-only.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}
